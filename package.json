{
  "name": "agent-squad-strapi",
  "version": "1.0.0",
  "description": "Antigravity AI IDE için Strapi v5 ve React / Next.js 8 Kişilik Otonom Yazılım Geliştirme Squad'ı",
  "main": "index.js",
  "scripts": {
    "depcruise:check": "depcruise --config .dependency-cruiser.js .",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix",
    "security:scan": "semgrep scan --config .agents/rules/semgrep/strapi-react-rules.yaml",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "antigravity",
    "ai-agents",
    "strapi-v5",
    "react",
    "nextjs",
    "clean-architecture",
    "feature-based-architecture",
    "modular-architecture",
    "owasp-asvs"
  ],
  "author": "Ertekin Özturgut",
  "license": "MIT",
  "devDependencies": {
    "@stryker-mutator/core": "^8.7.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dependency-cruiser": "^16.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-security": "^3.0.1",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
