      "type": "string",
      "required": true
    },
    "role": {
      "type": "string",
      "required": true
    },
    "period": {
      "type": "string"
    },
    "executiveSummary": {
      "type": "text",
      "required": true
    },
    "theChallenge": {
      "type": "text",
      "required": true
    },
    "architecturalSolution": {
      "type": "json"
    },
    "measurableOutcomes": {
      "type": "component",
      "repeatable": true,
      "component": "metrics.measurable-outcome"
    },
    "technologies": {
      "type": "json"
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
